# Copy to .env.local and fill in. Never commit real values.

# Public canonical URL of the site (no trailing slash). Used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (server-side only) via Resend (https://resend.com).
# In development, if these are empty, submissions are accepted and logged (without personal data).
# In production, missing values cause the form to return a recoverable error instead of discarding enquiries.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a verified sending domain, e.g. "NEXVYRA Labs <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
